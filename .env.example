# =============================================================================
# Environment contract for the car dealer chatbot.
# Copy to `.env` and fill in real values. `.env` is git-ignored; this file is not.
#
#     cp .env.example .env
#
# Every LLM_* key below is read by `config/settings.py` and consumed by
# `infrastructure/llm/factory.py`. Nothing else in the codebase reads them.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM provider
# -----------------------------------------------------------------------------
# The provider key is the ONLY switch the factory needs. It selects the adapter;
# the adapter is the same OpenAI-wire-protocol client for every service below.
#
#   openai_compatible   ->  OpenAI, Azure OpenAI, Groq, Together, DeepInfra,
#                          Fireworks, Ollama, vLLM, LM Studio, and any other
#                          service exposing a /v1-compatible chat completions API.
#
# Swapping providers requires NO code change: edit LLM_BASE_URL / LLM_API_KEY /
# LLM_MODEL and restart. Do not add a new provider value unless you have also
# added an adapter in `infrastructure/llm/`.
LLM_PROVIDER=openai_compatible

# Base URL of the chat completions endpoint. Must include the version segment.
#   OpenAI         https://api.openai.com/v1
#   Groq           https://api.groq.com/openai/v1
#   Together       https://api.together.xyz/v1
#   Ollama (local) http://localhost:11434/v1
#   LM Studio      http://localhost:1234/v1
#   Azure OpenAI   https://<resource>.openai.azure.com/openai/deployments/<deployment>
LLM_BASE_URL=https://api.openai.com/v1

# API key or token. Placeholder below is NOT a real credential. Local servers
# (Ollama, vLLM, LM Studio) usually accept any non-empty placeholder value.
LLM_API_KEY=your-api-key-here

# Model identifier as named by the provider. Must be a chat/completions model.
LLM_MODEL=gpt-4o-mini

# 0.0 so entity extraction is deterministic and the disambiguation and
# ambiguity branches stay testable. Raise only for free-form response wording.
LLM_TEMPERATURE=0.0

# Per-request timeout in seconds, and the bounded retry count with backoff.
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# -----------------------------------------------------------------------------
# Persistence
# -----------------------------------------------------------------------------
# SQLite by default so the assignment runs with no external service.
#   PostgreSQL: postgresql+psycopg://user:pass@localhost:5432/cardealer
DATABASE_URL=sqlite:///./data/cardealer.db

# Conversational session lifetime in seconds (in-memory session store).
SESSION_TTL_SECONDS=1800
