# =============================================================================
# Environment contract for the car dealer chatbot.
#
#     cp .env.example .env
#
# `.env` is git-ignored and must never be committed. This file is tracked and
# is the documented source of every setting the application reads.
#
# Every LLM_* key below is read by `config/settings.py` (Phase 5) and consumed
# by `infrastructure/llm/factory.py`. Nothing else in the codebase reads them,
# and no provider name is hardcoded anywhere in the source.
# =============================================================================


# #############################################################################
# LLM PROVIDER
# #############################################################################
# LLM_PROVIDER is the ONLY switch the factory needs. It selects the adapter
# inside `infrastructure/llm/factory.py`; the adapter is the same
# OpenAI-wire-protocol client for every service listed below.
#
#   openai_compatible  ->  OpenAI, Azure OpenAI, Groq, Together, DeepInfra,
#                          Fireworks, Ollama, vLLM, LM Studio, and any other
#                          service exposing a /v1-compatible chat completions
#                          API.
#
# SWAPPING PROVIDERS REQUIRES NO CODE CHANGE. Edit LLM_BASE_URL, LLM_API_KEY and
# LLM_MODEL, then restart. Do not add a new provider value unless you have also
# written an adapter in `infrastructure/llm/`.
LLM_PROVIDER=openai_compatible

# Base URL of the chat completions endpoint. Include the version segment.
#   OpenAI          https://api.openai.com/v1
#   Groq            https://api.groq.com/openai/v1
#   Together        https://api.together.xyz/v1
#   DeepInfra       https://api.deepinfra.com/v1/openai
#   Ollama (local)  http://localhost:11434/v1
#   vLLM (local)    http://localhost:8000/v1
#   LM Studio       http://localhost:1234/v1
#   Azure OpenAI    https://<resource>.openai.azure.com/openai/deployments/<deployment>
LLM_BASE_URL=https://api.openai.com/v1

# API key or token. The value below is a PLACEHOLDER, not a real credential.
# Local servers (Ollama, vLLM, LM Studio) usually accept any non-empty value.
#
# This is passed explicitly to the client, so the OpenAI SDK's own OPENAI_API_KEY
# lookup is bypassed. If you also have OPENAI_API_KEY exported in your shell it
# is ignored here -- do not let the two drift apart.
LLM_API_KEY=your-api-key-here

# Model identifier as named by the provider. Must be a chat/completions model.
LLM_MODEL=gpt-4o-mini

# 0.0 so entity extraction is deterministic and the disambiguation and
# ambiguity branches stay testable. Raise only if you want freer response
# wording; do not raise it for extraction.
LLM_TEMPERATURE=0.0

# Per-request timeout in seconds, and the bounded retry count with backoff.
# Keep MAX_RETRIES small: the chat loop calls the LLM up to three times per turn.
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2


# #############################################################################
# APPLICATION
# #############################################################################
# development | production. Only used to relax CORS and error detail in
# config/settings.py.
APP_ENV=development

APP_HOST=127.0.0.1
APP_PORT=8000


# #############################################################################
# PERSISTENCE
# #############################################################################
# SQLite by default, so the assignment runs with no external service.
#   PostgreSQL: postgresql+psycopg://user:pass@localhost:5432/cardealer
# The file is git-ignored; it is rebuilt from data/*.csv on startup.
DATABASE_URL=sqlite:///./data/cardealer.db

# Conversational session lifetime in seconds, enforced by the in-memory
# SessionStore. Expired sessions are replaced by a fresh one.
SESSION_TTL_SECONDS=1800


# #############################################################################
# WORKED EXAMPLES -- uncomment one block instead of editing the keys above.
# #############################################################################

# --- Fully local, no API key, no cost ---------------------------------------
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1
# LLM_TIMEOUT_SECONDS=60

# --- Groq (fast, cheap, generous free tier) ----------------------------------
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your-groq-key-here
# LLM_MODEL=llama-3.3-70b-versatile

# --- Azure OpenAI (note the deployment-scoped base URL) ---------------------
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://<resource>.openai.azure.com/openai/deployments/<deployment>
# LLM_API_KEY=your-azure-key-here
# LLM_MODEL=gpt-4o
