{
  "id": "edge_03_input_validation",
  "title": "Empty input, very long input and missing fields",
  "suite": "edge",
  "description": "Boundary behaviour of the DTO contract: empty and over-long messages are rejected with 422 before any business logic runs; whitespace and exactly 2000 characters are accepted and degrade gracefully. The 2000-char message is generated by scripts/run_scenarios.py when it sees the '$long_message' placeholder (see README).",
  "plan_refs": [
    "plan.md §3 Session: Empty input",
    "plan.md §3 Session: Very long input"
  ],
  "tags": [
    "session",
    "validation"
  ],
  "steps": [
    {
      "name": "empty message is rejected",
      "request": {
        "session_id": null,
        "message": ""
      },
      "expect": {
        "status": {
          "in": [
            422
          ]
        }
      }
    },
    {
      "name": "whitespace-only message degrades gracefully",
      "llm": {
        "intent": "UNKNOWN"
      },
      "request": {
        "session_id": null,
        "message": "   "
      },
      "expect": {
        "status": 200,
        "body": {
          "reply": {
            "any_of": [
              {
                "regex": "didn't understand"
              },
              {
                "regex": "not sure"
              },
              {
                "regex": "What date and time"
              }
            ]
          },
          "workflow_state": {
            "in": [
              "START",
              "AWAITING_CAR",
              "AWAITING_DATETIME"
            ]
          }
        }
      }
    },
    {
      "name": "exactly 2000 characters is still valid",
      "llm": {
        "intent": "UNKNOWN"
      },
      "request": {
        "session_id": null,
        "message": "$long_message:2000"
      },
      "expect": {
        "status": 200,
        "body": {
          "reply": {
            "min_length": 1,
            "max_length": 2000
          }
        }
      }
    },
    {
      "name": "2001 characters is rejected at the DTO boundary",
      "request": {
        "session_id": null,
        "message": "$long_message:2001"
      },
      "expect": {
        "status": {
          "in": [
            422
          ]
        }
      }
    },
    {
      "name": "request without a message field is rejected",
      "request": {
        "session_id": null
      },
      "expect": {
        "status": {
          "in": [
            422
          ]
        }
      }
    }
  ]
}
