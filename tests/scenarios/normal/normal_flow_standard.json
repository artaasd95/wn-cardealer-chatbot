{
  "id": "normal_flow_standard",
  "title": "Standard multi-stage flow: greeting \u2192 search \u2192 dealer \u2192 schedule",
  "suite": "normal",
  "description": "The four-stage happy path: greeting, car search (single match), dealer details, and scheduling.  Verifies the complete end-to-end conversation from first contact to confirmed appointment.  Matches the flow: greetings \u2192 car search \u2192 dealer details \u2192 schedule.",
  "plan_refs": ["plan.md \u00a72 main flows", "plan.md \u00a72 State transitions"],
  "tags": ["greeting", "item_lookup", "dealer_details", "schedule_call", "multi_stage", "happy_path"],
  "steps": [
    {
      "name": "1. greeting",
      "request": {"session_id": null, "message": "Hello!", "user_id": "scenario-user"},
      "llm": {"intent": "GREETING", "reply": ""},
      "expect": {
        "status": 200,
        "body": {
          "session_id": {"regex": "^[0-9a-fA-F-]{36}$"},
          "workflow_state": {"equals": "START"},
          "reply": {"all_of": [{"min_length": 1}, {"regex": "(?i)(hello|hi|welcome|help)"}]},
          "suggested_actions": {"contains_any": ["(?i)find a car"]}
        }
      }
    },
    {
      "name": "2. car search (single match)",
      "request": {"session_id": "$session", "message": "I'm looking for a BMW 3 Series 320i 2021"},
      "llm": {
        "intent": "ITEM_LOOKUP",
        "car": {"make": "BMW", "model": "3 Series", "variant": "320i", "year_from": 2021, "year_to": 2021}
      },
      "expect": {
        "status": 200,
        "body": {
          "session_id": {"equals": "$session"},
          "workflow_state": {"equals": "AWAITING_ACTION"},
          "reply": {"regex": "^Found BMW 3 Series 320i \\(2021\\)"},
          "suggested_actions": {"equals": ["Get dealer details", "Schedule a call", "Find another car"]}
        }
      }
    },
    {
      "name": "3. dealer details",
      "request": {"session_id": "$session", "message": "Great, show me the dealer details"},
      "llm": {"intent": "DEALER_DETAILS", "reply": ""},
      "expect": {
        "status": 200,
        "body": {
          "session_id": {"equals": "$session"},
          "workflow_state": {"equals": "DEALER_DETAILS_SHOWN"},
          "reply": {"all_of": [{"regex": "Prestige Cars"}, {"regex": "Bangalore"}, {"regex": "2552|phone|Phone"}], "must_not": [{"regex": "(?i)(system prompt|You are a)"}]},
          "suggested_actions": {"equals": ["Schedule a call", "Find another car"]}
        }
      }
    },
    {
      "name": "4. schedule a call",
      "request": {"session_id": "$session", "message": "Please schedule a call for 2030-05-15 at 15:00 UTC"},
      "llm": {
        "intent": "SCHEDULE_CALL",
        "schedule": {"date_raw": "2030-05-15", "time_raw": "15:00", "timezone": "UTC"},
        "reply": ""
      },
      "expect": {
        "status": 200,
        "body": {
          "session_id": {"equals": "$session"},
          "workflow_state": {"equals": "SCHEDULE_CONFIRMED"},
          "reply": {"all_of": [{"regex": "(?i)(book|schedul|confirm)"}, {"regex": "(?i)prestige cars"}, {"regex": "2552\\D{0,2}1003"}], "must_not": [{"regex": "(?i)(could not|failed)"}]},
          "suggested_actions": {"equals": ["Find another car", "Get dealer details"]}
        }
      }
    }
  ]
}